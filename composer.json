{
    "name": "dillonsmart/tetherphp",
    "type": "project",
    "description": "TetherPHP is a PHP framework which ships as a skeleton application.",
    "keywords": [
        "tetherphp",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "dillonsmart/tetherphp-core": "^0.5"
    },
    "autoload": {
        "psr-4": {
            "Actions\\": "app/Actions/",
            "Commands\\": "app/Commands/",
            "Responders\\": "app/Responders/",
            "Domains\\": "app/Domains/",
            "Views\\": "app/Views/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
