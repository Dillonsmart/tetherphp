#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * The console itself lives in the framework package, at
 * vendor/dillonsmart/tetherphp-core/bin/tether. This file is only a shim so
 * that `php tether` keeps working from the project root; Composer generates
 * the proxy below when it installs the package, and the proxy hands the
 * autoloader to the real binary.
 */

$binary = __DIR__ . '/vendor/bin/tether';

if (!is_file($binary)) {
    fwrite(STDERR, "TetherPHP console not found at vendor/bin/tether. Run composer install.\n");
    exit(1);
}

return require $binary;
